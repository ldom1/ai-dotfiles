[Unit]
Description=Copy the vault's dev projects to the Notion targets database (capture targets)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/ai-dotfiles/config/brain.env
# NOTION_TOKEN and NOTION_TARGETS_DATABASE_ID come from the notion-pilot Infisical project (env prod).
ExecStart=/usr/bin/env infisical run --domain https://infisical.dombot.tech --projectId 71e743d9-5a88-4125-8703-bd75de5fee23 --env prod --silent -- %h/ai-dotfiles/skills/brain-sync/scripts/sync_dev_projects.py
