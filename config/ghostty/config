# Ghostty — AI.files (Ubuntu natif). Lien : ~/.config/ghostty/config
# tmux gère les splits, les onglets et les sessions : Ghostty reste une fenêtre simple.

font-family = JetBrainsMono Nerd Font
font-size = 11
background = #0E0F13
foreground = #D8DCE6
window-padding-x = 6
window-padding-y = 4

# Copie : tmux émet de l'OSC 52, Ghostty l'écrit dans le presse-papiers.
clipboard-write = allow
clipboard-read = ask

# Raccourcis Ghostty par défaut qui entrent en collision avec la config tmux.
# On les remplace par la séquence CSI u (code de la lettre ; 6 = Ctrl+Shift),
# que tmux reconnaît comme Ctrl+Shift+lettre, distincte de Ctrl+lettre.
keybind = ctrl+shift+o=csi:111;6u
keybind = ctrl+shift+e=csi:101;6u
keybind = ctrl+shift+n=csi:110;6u
keybind = ctrl+shift+x=csi:120;6u
keybind = ctrl+shift+b=csi:98;6u
# Ctrl+Shift+Q reste « quitter Ghostty » : la sauvegarde-et-sortie tmux prend une autre touche.
