+fn session_agents(session: &SessionData) -> Vec<&AgentEvent> {
+    if session.agents.is_empty() {
+        session.agent_state.iter().collect()
+    } else {
+        session.agents.iter().collect()
+    }
+}
+
+/// One line under the session: agent count for each status, most urgent first ("◉ 1 blocked  ⠹ 2 working").
+fn build_session_agents_row(
+    app: &App,
+    palette: &Palette,
+    session: &SessionData,
+    tree: TreePosition,
+    width: usize,
+) -> StyledLine {
+    let focused = app.focused_session_name() == Some(session.name.as_str());
+    let hit = HitTarget::Session(session.name.clone());
+    let flashed = app.active_flash_target() == Some(&hit);
+    let mut line = StyledLine::with_bg((focused || flashed).then_some(palette.surface1));
+    line.push(tree_detail_prefix(tree), palette.surface2);
+    let mut kinds = session_agents(session)
+        .into_iter()
+        .map(agent_visual_kind)
+        .collect::<Vec<_>>();
+    kinds.sort_by(|a, b| b.cmp(a));
+    kinds.dedup_by(|a, b| a == b);
+    for (idx, kind) in kinds.into_iter().enumerate() {
+        let count = session_agents(session)
+            .into_iter()
+            .filter(|agent| agent_visual_kind(agent) == kind)
+            .count();
+        let visual = agent_visual_for_kind(palette, kind, spinner_clock(app));
+        let text = format!(
+            "{}{} {} {}",
+            if idx > 0 { "  " } else { "" },
+            visual.glyph,
+            count,
+            visual.label
+        );
+        if line.width() + text.width() > width {
+            break;
+        }
+        line.push(text, visual.color);
+    }
+    line.end(CellStyle {
+        fg: palette.white,
+        bg: (focused || flashed).then_some(palette.surface1),
+    })
+    .with_hit(hit)
+}
