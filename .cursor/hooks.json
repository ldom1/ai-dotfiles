{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "./hooks/session-start.sh", "timeout": 120 }],
    "sessionEnd": [{ "command": "./hooks/session-end.sh", "timeout": 180 }],
    "preToolUse": [
      {
        "command": "./hooks/log-skill-usage.sh",
        "matcher": "Read"
      }
    ]
  }
}
