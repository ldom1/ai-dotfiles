#!/usr/bin/env bash
# Vibe entry: sync start, write ~/.vibe/brain-context.md, run vibe, sync end. Works from any cwd.
# Alias (not export) in ~/.zshrc: alias vibe=vibe-brain. Exit code: Vibe's (130 on INT, 143 on TERM).
set -uo pipefail

AI_DOTFILES="${AI_DOTFILES:-$HOME/ai-dotfiles}"
SYNC="$AI_DOTFILES/skills/brain-sync/scripts/sync.sh"
CTX_FILE="$HOME/.vibe/brain-context.md"

ENV_FILE="${BRAIN_ENV_FILE:-$AI_DOTFILES/config/brain.env}"
# shellcheck source=/dev/null
[[ -f "$ENV_FILE" ]] && source "$ENV_FILE"
[[ -z "${BRAIN_PATH:-}" ]] || export BRAIN_PATH  # capture finds the vault through it

started=0
# The pull failed: no push at the end (it can conflict). Same rule as .vibe/bootstrap.md.
if bash "$SYNC" start; then
  started=1
else
  echo "[vibe-brain] WARNING: sync.sh start failed; running Vibe on the local vault, no sync end." >&2
fi

mkdir -p "${CTX_FILE%/*}"
tmp="$CTX_FILE.$$.tmp"
if bash "$AI_DOTFILES/scripts/brain-context.sh" >"$tmp" 2>/dev/null && mv -f "$tmp" "$CTX_FILE"; then
  :
else
  rm -f "$tmp" "$CTX_FILE"  # a stale context is worse than none
  echo "[vibe-brain] WARNING: brain-context.sh failed; no ~/.vibe/brain-context.md." >&2
fi

child=0
finish() {  # runs once, on every exit path; keeps Vibe's code
  local rc=$?
  trap - EXIT
  if (( started )); then
    bash "$SYNC" end || echo "[vibe-brain] WARNING: sync.sh end failed (exit $?)." >&2
  fi
  exit "$rc"
}
on_signal() {  # $1: exit code; $2: 1 = pass TERM on to Vibe (a signal to the launcher alone does not reach it)
  if (( child > 0 )); then
    (( $2 == 0 )) || kill -TERM "$child" 2>/dev/null
    wait "$child" 2>/dev/null
  fi
  exit "$1"
}
trap finish EXIT
trap 'on_signal 130 0' INT
trap 'on_signal 143 1' TERM

# Background + wait: bash runs a trap only between commands, so a foreground Vibe would delay TERM until it exits.
# <&0 keeps the terminal; the child stays in this process group, so it still gets Ctrl-C.
vibe "$@" <&0 &
child=$!
wait "$child"
