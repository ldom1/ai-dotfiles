#!/usr/bin/env bash
# aif-agent-hook — appelé par les hooks Claude Code. Écrit l'état de l'agent du
# panneau courant dans $AIF_STATE_DIR/<clé>.json : pane tmux (clé = numéro du pane) ou pane Herdr
# (HERDR_ENV=1, clé = herdr-<HERDR_PANE_ID, hors [A-Za-z0-9] remplacé par ->). Dans un pane Herdr, il
# rapporte aussi l'état à Herdr (herdr pane report-agent). Ne bloque jamais Claude : sort toujours
# en 0, ne fait rien ailleurs. Champs d'entrée : https://code.claude.com/docs/en/hooks
set -uo pipefail
if [[ -n ${TMUX_PANE:-} ]]; then
  PANE=$TMUX_PANE KEY=${TMUX_PANE#%} HERDR=0
elif [[ ${HERDR_ENV:-} == 1 && -n ${HERDR_PANE_ID:-} ]]; then
  PANE=$HERDR_PANE_ID KEY="herdr-${HERDR_PANE_ID//[^A-Za-z0-9]/-}" HERDR=1
else
  exit 0
fi
command -v jq >/dev/null || exit 0

# Budget : < 100 ms par événement. Un seul appel jq (≈ 18 ms avec jq 1.6), pas de date ni de mktemp.
STATE_DIR=${AIF_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp/aif-$UID}/aif/agents}
[[ -d $STATE_DIR ]] || mkdir -p "$STATE_DIR" 2>/dev/null || exit 0
FILE="$STATE_DIR/$KEY.json"
cur=$FILE; [[ -f $cur ]] || cur=/dev/null
input=$(cat)

# Filtre jq : $in = entrée du hook, `.` = état existant. Rend « événement \t état avant \t état après \t
# session \t nature de la question » (« - » si absent : read ne garde pas les champs vides), puis le
# nouvel état en JSON ; seulement la 1re ligne pour SessionEnd et les événements ignorés.
JQ='
. as $in | ($cur[0] // {}) as $s | ($s.state // "-") as $prev | ($in.hook_event_name // "") as $ev
| ($s
  | if $ev == "SessionStart" then
      # source=compact : compaction en cours de tour, l agent continue (garder état et sous-agents)
      .tool = "claude" | .session_id = $in.session_id
      | if $in.source == "compact" then . else .state = "done" | .started_at = $now | .subagents = {} | .question = null | .options = [] end
    elif $ev == "UserPromptSubmit" then
      .state = "running" | .prompt_at = $now | .task = (($in.prompt // "") | split("\n")[0] | .[0:80]) | .question = null | .options = []
    elif $ev == "PreToolUse" then
      if $in.tool_name == "AskUserQuestion" then
        .state = "check" | .question = ($in.tool_input.questions[0].question // "Question")
        | .options = [($in.tool_input.questions[0].options // [])[] | .label] | .ask = "tool"
      else
        # Outil et argument principal, affichés si une permission est demandée ensuite
        .state = "running" | .last_tool = $in.tool_name
        | .pending = ("\($in.tool_name): " + (($in.tool_input.command // $in.tool_input.file_path // $in.tool_input.url
            // $in.tool_input.pattern // $in.tool_input.description // "") | tostring | split("\n")[0]) | .[0:120])
      end
    elif $ev == "PostToolUse" or $ev == "PostToolUseFailure" then
      .state = "running" | .question = null | .options = [] | .last_tool = $in.tool_name
    elif $ev == "Notification" then
      # AskUserQuestion déclenche aussi permission_prompt : garder la question déjà posée
      if ($in.notification_type == "permission_prompt" or $in.notification_type == "elicitation_dialog") and .state != "check" then
        .state = "check" | .question = (.pending // $in.message // "Permission requested") | .options = ["Yes", "Always", "No"] | .ask = "permission"
      else . end
    elif $ev == "Stop" then
      # Question laissée en prose : dernière ligne non vide finissant par ? ou ？, hors bloc de code
      # (nombre impair de lignes ``` : la dernière ligne est dans un bloc) et hors URL avec ?.
      # Même règle dans scripts/replay-prose-questions.py (is_question) : modifier les deux ensemble.
      # (.ask reste jusqu a la prochaine entrée dans check)
      (($in.last_assistant_message // "") | sub("\\s+$"; "") | split("\n")) as $l
      | ($l | last // "") as $q
      | (.last_message = (($in.last_assistant_message // "") | .[0:200])) as $d
      | if ($q | (endswith("?") or endswith("？"))) and ([$l[] | select(test("^\\s*```"))] | length % 2 == 0)
          and ($q | test("https?://\\S*\\?\\S*$") | not)
        then $d | .state = "check" | .question = $q[0:200] | .options = [] | .ask = "prose"
        else $d | .state = "done" | .question = null | .options = [] end
    elif $ev == "StopFailure" then .state = "error" | .error = ($in.error // "unknown")
    elif $ev == "SubagentStart" then
      .subagents[$in.agent_id] = {type: ($in.agent_type // "agent"), state: "running", since: $now}
    elif $ev == "SubagentStop" then
      if .subagents[$in.agent_id] then .subagents[$in.agent_id].state = "done" else . end
    else null end) as $o
| if $o == null then "\($ev)\t\($prev)\t-"
  else ($o | .pane = $pane | .cwd = ($in.cwd // .cwd) | .event = $ev | .updated_at = $now) as $o
    | "\($ev)\t\($prev)\t\($o.state // "-")\t\($in.session_id // "-")\t\($o.ask // "-")", ($o | tojson)
  end'

# Entrée du hook sur stdin, pas en argument : un tool_input de plus de 128 Ko (Write) dépasserait
# la taille maximale d'un argument.
out=$(jq -r --slurpfile cur "$cur" --argjson now "$EPOCHSECONDS" --arg pane "$PANE" "$JQ" <<<"$input" 2>/dev/null) || exit 0
IFS=$'\t' read -r event prev_state new_state sid ask <<<"${out%%$'\n'*}"
[[ $event == SessionEnd ]] && { rm -f "$FILE"; exit 0; }
[[ $out == *$'\n'* ]] || exit 0   # événement ignoré
tmp="$STATE_DIR/.$$.tmp"
printf '%s\n' "${out#*$'\n'}" >"$tmp" && mv "$tmp" "$FILE" || { rm -f "$tmp"; exit 0; }

# Journal des questions : une ligne « epoch \t session \t enter|leave \t nature \t clé du pane » à chaque entrée dans
# check et sortie de check. .ask n est jamais effacé : la ligne leave porte la nature de la question
# qu elle ferme. Ni texte ni option : seulement des identifiants et des énumérations.
if [[ $new_state != "$prev_state" ]] && [[ $new_state == check || $prev_state == check ]]; then
  CHECK_LOG=${AIF_CHECK_LOG:-$HOME/.claude/logs/aif-check.log}
  [[ -d ${CHECK_LOG%/*} ]] || mkdir -p "${CHECK_LOG%/*}" 2>/dev/null
  kind=enter; [[ $new_state == check ]] || kind=leave
  { printf '%s\t%s\t%s\t%s\t%s\n' "$EPOCHSECONDS" "$sid" "$kind" "$ask" "$KEY" >>"$CHECK_LOG"; } 2>/dev/null
fi

# Pane Herdr : rapporter le nouvel état à Herdr, en fond. --seq vient d'un compteur partagé sous flock,
# max(µs, précédent + 1) : il croît même si l'horloge recule ou si deux hooks tournent en même temps.
# Puis sortir : le serveur tmux peut tourner à côté, il ne faut jamais le viser hors tmux.
if (( HERDR )); then
  if [[ $new_state != "$prev_state" && -x ${HERDR_BIN_PATH:-} ]]; then
    seq=$(exec 9>>"$STATE_DIR/herdr.seq.lock"; flock -w 1 9 || exit 1
          prev=$(cat "$STATE_DIR/herdr.seq" 2>/dev/null); now=${AIF_NOW_US:-${EPOCHREALTIME/./}}
          (( now > ${prev:-0} )) || now=$(( prev + 1 )); echo "$now" >"$STATE_DIR/herdr.seq"; echo "$now") || exit 0
    case $new_state in running) hs=working ;; check) hs=blocked ;; *) hs=idle ;; esac
    args=(pane report-agent "$HERDR_PANE_ID" --source aif-dotdeck --agent claude --state "$hs" --seq "$seq")
    [[ $hs == blocked ]] && args+=(--message "$(jq -r '.question // "" | .[0:200]' "$FILE")")
    "$HERDR_BIN_PATH" "${args[@]}" </dev/null >/dev/null 2>&1 &
  fi
  exit 0
fi

# Notification système seulement à l'entrée dans un état, et si le panneau n'est pas sous les yeux.
if [[ $new_state != "$prev_state" ]] && { [[ $new_state == check ]] || { [[ $new_state == "done" && ${AIF_NOTIFY_DONE:-0} == 1 ]]; }; }; then
  visible=$(tmux display -p -t "$TMUX_PANE" '#{&&:#{session_attached},#{&&:#{window_active},#{pane_active}}}' 2>/dev/null)
  # Descripteurs fermés : la notification (notify-send --wait) ne doit pas garder ouvert le stdout
  # du hook, que Claude Code attend.
  # aif-platform : PATH, sinon ~/.local/bin (PATH de Claude Code sans ce dossier)
  platform=$(command -v aif-platform || echo "$HOME/.local/bin/aif-platform")
  # Seulement si tmux répond 0 : sans réponse (pas de serveur, pane mort, tmux factice d'un banc
  # d'essai), pas de notification. Un benchmark du hook a ainsi envoyé ~100 toasts en 40 s.
  if [[ $visible == 0 && -x $platform ]]; then
    sess=$(tmux display -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null)
    if [[ $new_state == check ]]; then
      "$platform" notify "◉ $sess needs you" "$(jq -r '.question // ""' "$FILE")" "$sess" critical </dev/null >/dev/null 2>&1 &
    else
      "$platform" notify "✓ $sess finished" "$(jq -r '.task // ""' "$FILE")" "$sess" </dev/null >/dev/null 2>&1 &
    fi
  fi
fi
tmux refresh-client -S </dev/null >/dev/null 2>&1 &
exit 0
