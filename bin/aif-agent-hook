#!/usr/bin/env bash
# aif-agent-hook — appelé par les hooks Claude Code. Écrit l'état de l'agent du
# panneau tmux courant dans $AIF_STATE_DIR/<pane>.json. Ne bloque jamais Claude :
# sort toujours en 0, ne fait rien hors tmux. Champs d'entrée : https://code.claude.com/docs/en/hooks
set -uo pipefail
[[ -n ${TMUX_PANE:-} ]] || exit 0
command -v jq >/dev/null || exit 0

# Budget : < 100 ms par événement. Deux appels jq en tout, pas de date ni de mktemp.
STATE_DIR=${AIF_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp/aif-$UID}/aif/agents}
[[ -d $STATE_DIR ]] || mkdir -p "$STATE_DIR" 2>/dev/null || exit 0
FILE="$STATE_DIR/${TMUX_PANE#%}.json"
[[ -f $FILE ]] || echo '{}' >"$FILE"
input=$(cat)
IFS=$'\t' read -r event prev_state < <(jq -r --slurpfile cur "$FILE" \
  '[.hook_event_name // "", ($cur[0].state // "-")] | @tsv' <<<"$input" 2>/dev/null)
[[ -n ${event:-} ]] || exit 0

# filtre jq appliqué à l'état existant ; $in = entrée du hook
case $event in
  SessionStart)
    # source=compact : compaction en cours de tour, l'agent continue (garder état et sous-agents)
    f='.tool="claude" | .session_id=$in.session_id
       | if $in.source=="compact" then . else .state="done" | .started_at=$now | .subagents={} | .question=null | .options=[] end' ;;
  UserPromptSubmit)
    f='.state="running" | .task=(($in.prompt // "") | split("\n")[0] | .[0:80]) | .question=null | .options=[]' ;;
  PreToolUse)
    f='if $in.tool_name=="AskUserQuestion" then
         .state="check" | .question=($in.tool_input.questions[0].question // "Question")
         | .options=[($in.tool_input.questions[0].options // [])[] | .label]
       else .state="running" | .last_tool=$in.tool_name end' ;;
  PostToolUse|PostToolUseFailure)
    f='.state="running" | .question=null | .options=[] | .last_tool=$in.tool_name' ;;
  Notification)
    f='if ($in.notification_type=="permission_prompt" or $in.notification_type=="elicitation_dialog") then
         .state="check" | .question=($in.message // "Permission requested")
         | (if (.options|length)==0 then .options=["Yes","Always","No"] else . end)
       else . end' ;;
  Stop)
    f='.state="done" | .question=null | .options=[] | .last_message=(($in.last_assistant_message // "") | .[0:200])' ;;
  StopFailure)
    f='.state="error" | .error=($in.error // "unknown")' ;;
  SubagentStart)
    f='.subagents[$in.agent_id]={type:($in.agent_type // "agent"), state:"running", since:$now}' ;;
  SubagentStop)
    f='if .subagents[$in.agent_id] then .subagents[$in.agent_id].state="done" else . end' ;;
  SessionEnd)
    rm -f "$FILE"; exit 0 ;;
  *) exit 0 ;;
esac

tmp="$STATE_DIR/.$$.tmp"
# Entrée du hook sur stdin, pas en argument : un tool_input de plus de 128 Ko (Write) dépasserait
# la taille maximale d'un argument.
# Sortie : le nouvel état sur la 1re ligne, puis l'objet complet (évite un 3e appel jq).
out=$(jq -c --slurpfile cur "$FILE" --argjson now "$EPOCHSECONDS" --arg pane "$TMUX_PANE" --arg event "$event" \
      ". as \$in | \$cur[0] | $f | .pane=\$pane | .cwd=(\$in.cwd // .cwd) | .event=\$event | .updated_at=\$now
       | (.state // \"\"), ." <<<"$input" 2>/dev/null) || exit 0
new_state=${out%%$'\n'*}; new_state=${new_state//\"/}
printf '%s\n' "${out#*$'\n'}" >"$tmp" && mv "$tmp" "$FILE" || { rm -f "$tmp"; exit 0; }

# Notification système seulement à l'entrée dans un état, et si le panneau n'est pas sous les yeux.
if [[ $new_state != "$prev_state" ]] && { [[ $new_state == check ]] || { [[ $new_state == "done" && ${AIF_NOTIFY_DONE:-0} == 1 ]]; }; }; then
  visible=$(tmux display -p -t "$TMUX_PANE" '#{&&:#{session_attached},#{&&:#{window_active},#{pane_active}}}' 2>/dev/null)
  # Descripteurs fermés : la notification (notify-send --wait) ne doit pas garder ouvert le stdout
  # du hook, que Claude Code attend.
  if [[ $visible != 1 ]] && command -v aif-platform >/dev/null; then
    sess=$(tmux display -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null)
    if [[ $new_state == check ]]; then
      aif-platform notify "◉ $sess needs you" "$(jq -r '.question // ""' "$FILE")" "$sess" critical </dev/null >/dev/null 2>&1 &
    else
      aif-platform notify "✓ $sess finished" "$(jq -r '.task // ""' "$FILE")" "$sess" </dev/null >/dev/null 2>&1 &
    fi
  fi
fi
tmux refresh-client -S </dev/null >/dev/null 2>&1 &
exit 0
