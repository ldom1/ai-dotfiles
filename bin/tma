#!/usr/bin/env bash
# tma [dir] — attach to, or create, the tmux session for dir (named after it).
# The session-created hook in tmux.conf adds the session sidebar (tma-nav) on the left.
set -euo pipefail

dir=$(realpath "${1:-$PWD}")
name=$( [ "$dir" = "$HOME" ] && echo main || basename "$dir" | tr '.:' '__' )

tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$dir"

if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$name"; else exec tmux attach -t "=$name"; fi
